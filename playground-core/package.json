{
  "name": "@language-playground/ide",
  "version": "1.0.0",
  "type": "module",
  "description": "Browser IDE with pluggable language services and execution backends",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/types/api.d.ts",
      "import": "./dist/api.js"
    },
    "./editor": {
      "types": "./dist/types/editor/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./transport": {
      "types": "./dist/types/transport/index.d.ts",
      "import": "./dist/transport.js"
    },
    "./lsp": {
      "types": "./dist/types/adapters/lsp/service.d.ts",
      "import": "./dist/lsp.js"
    },
    "./examples": {
      "types": "./dist/types/workspace/examples.d.ts",
      "import": "./dist/examples.js"
    },
    "./themes": {
      "types": "./dist/types/appearance/index.d.ts",
      "import": "./dist/themes.js"
    },
    "./workspace": {
      "types": "./dist/types/workspace/index.d.ts",
      "import": "./dist/workspace.js"
    },
    "./styles.css": "./dist/styles.css",
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./embedded": {
      "types": "./dist/types/embedded/index.d.ts",
      "import": "./dist/embedded.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && npm run docs:check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "watch": "vite build --watch",
    "docs:api": "node scripts/api-docs.mjs",
    "docs:check": "node scripts/api-docs.mjs --check",
    "test:standalone": "node scripts/test-standalone.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@mantine/notifications": "9.6.1",
    "@tabler/icons-react": "^3.35.0",
    "@zip.js/zip.js": "2.15.0",
    "fflate": "^0.8.2",
    "modern-tar": "0.8.5",
    "monaco-editor": "0.56.0",
    "react-resizable-panels": "^4.12.4",
    "vscode-languageserver-protocol": "^3.17.5",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "dompurify": "^3.4.15"
  }
}
